# Copy to shared/secrets.auto.tfvars and fill in your values.
# This file is gitignored. Back it up alongside the tfstate.

# ============================================================
# Proxmox
# ============================================================
proxmox_endpoint  = "https://<PROXMOX_VIP_OR_FIRST_NODE>:8006"
proxmox_username  = "root@pam"
proxmox_password  = "<YOUR_PROXMOX_ROOT_PW>"   # or API token value
proxmox_insecure  = true                        # flip to false once you have valid certs
proxmox_node_name = "pve-1"                     # must match a node's pve_node field below

# ============================================================
# Talos cluster
# ============================================================
# VIP floats across the controlplanes on the LAN (uplink) NIC. Same subnet as
# the nodes' LAN IPs, outside DHCP scope, not assigned to any machine.
talos_cluster_vip = "<TALOS_API_VIP>"           # e.g. 192.168.1.100

# ============================================================
# Networking
# ============================================================
# Defaults shown — uncomment to override.
# lan_bridge  = "vmbr0"          # 1G uplink to the router
# mesh_bridge = "vmbr1"          # OVS RSTP bridge over the two 20G mesh NICs
# mesh_cidr   = "10.10.0.0/24"   # cluster network; static mesh_ip per node below
# mesh_mtu    = 9000

# ============================================================
# Nodes — one entry per Talos VM
# ============================================================
# 3 Proxmox hosts x (1 controlplane + 2 workers). pve_node becomes the node's
# topology.kubernetes.io/zone label, so keep it accurate — it is what keeps
# Ceph replicas, Vault raft members and CNPG instances on different hosts.
#
# Don't rename keys after first apply (Ceph OSD / CRUSH entries are per
# hostname). Size cpu/memory/disks to your hardware; workers carry the
# workloads and the Ceph OSDs (ceph_disk_gb -> /dev/vdb).
#
# Generate LAN MACs with: printf "BC:24:11:%02X:%02X:%02X\n" $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256))
# Reserve each MAC as a static DHCP lease on the router so LAN IPs don't drift.
# The mesh NIC gets a static mesh_ip and a Proxmox-generated MAC.

nodes = {
  # ---------------- pve-1 ----------------
  "cp-1" = {
    role        = "controlplane"
    vm_id       = 100
    pve_node    = "pve-1"
    proxmox_ip  = "<PROXMOX_1_IP>"
    cpu_cores   = 4
    memory_mb   = 8192
    disk_gb     = 50
    ip_address  = "<CP_1_LAN_IP>"
    mac_address = "<CP_1_MAC>"
    mesh_ip     = "10.10.0.11"
  }
  "wk-1a" = {
    role         = "worker"
    vm_id        = 110
    pve_node     = "pve-1"
    proxmox_ip   = "<PROXMOX_1_IP>"
    cpu_cores    = 8
    memory_mb    = 32768
    disk_gb      = 100
    ceph_disk_gb = 500
    ip_address   = "<WK_1A_LAN_IP>"
    mac_address  = "<WK_1A_MAC>"
    mesh_ip      = "10.10.0.21"
  }
  "wk-1b" = {
    role         = "worker"
    vm_id        = 111
    pve_node     = "pve-1"
    proxmox_ip   = "<PROXMOX_1_IP>"
    cpu_cores    = 8
    memory_mb    = 32768
    disk_gb      = 100
    ceph_disk_gb = 500
    ip_address   = "<WK_1B_LAN_IP>"
    mac_address  = "<WK_1B_MAC>"
    mesh_ip      = "10.10.0.22"
  }

  # ---------------- pve-2 ----------------
  "cp-2" = {
    role        = "controlplane"
    vm_id       = 200
    pve_node    = "pve-2"
    proxmox_ip  = "<PROXMOX_2_IP>"
    cpu_cores   = 4
    memory_mb   = 8192
    disk_gb     = 50
    ip_address  = "<CP_2_LAN_IP>"
    mac_address = "<CP_2_MAC>"
    mesh_ip     = "10.10.0.12"
  }
  "wk-2a" = {
    role         = "worker"
    vm_id        = 210
    pve_node     = "pve-2"
    proxmox_ip   = "<PROXMOX_2_IP>"
    cpu_cores    = 8
    memory_mb    = 32768
    disk_gb      = 100
    ceph_disk_gb = 500
    ip_address   = "<WK_2A_LAN_IP>"
    mac_address  = "<WK_2A_MAC>"
    mesh_ip      = "10.10.0.23"
  }
  "wk-2b" = {
    role         = "worker"
    vm_id        = 211
    pve_node     = "pve-2"
    proxmox_ip   = "<PROXMOX_2_IP>"
    cpu_cores    = 8
    memory_mb    = 32768
    disk_gb      = 100
    ceph_disk_gb = 500
    ip_address   = "<WK_2B_LAN_IP>"
    mac_address  = "<WK_2B_MAC>"
    mesh_ip      = "10.10.0.24"
  }

  # ---------------- pve-3 ----------------
  "cp-3" = {
    role        = "controlplane"
    vm_id       = 300
    pve_node    = "pve-3"
    proxmox_ip  = "<PROXMOX_3_IP>"
    cpu_cores   = 4
    memory_mb   = 8192
    disk_gb     = 50
    ip_address  = "<CP_3_LAN_IP>"
    mac_address = "<CP_3_MAC>"
    mesh_ip     = "10.10.0.13"
  }
  "wk-3a" = {
    role         = "worker"
    vm_id        = 310
    pve_node     = "pve-3"
    proxmox_ip   = "<PROXMOX_3_IP>"
    cpu_cores    = 8
    memory_mb    = 32768
    disk_gb      = 100
    ceph_disk_gb = 500
    ip_address   = "<WK_3A_LAN_IP>"
    mac_address  = "<WK_3A_MAC>"
    mesh_ip      = "10.10.0.25"
  }
  "wk-3b" = {
    role         = "worker"
    vm_id        = 311
    pve_node     = "pve-3"
    proxmox_ip   = "<PROXMOX_3_IP>"
    cpu_cores    = 8
    memory_mb    = 32768
    disk_gb      = 100
    ceph_disk_gb = 500
    ip_address   = "<WK_3B_LAN_IP>"
    mac_address  = "<WK_3B_MAC>"
    mesh_ip      = "10.10.0.26"
  }
}

# ============================================================
# Bootstrap-time secrets
# ============================================================
# These can also be set via TF_VAR_<name> env vars (preferred — keeps them out
# of the tfvars file). Generate the Cloudflare API token in the dashboard with
# Zone:DNS:Edit + Zone:Zone:Read scoped to your cert-manager-managed zones.
cloudflare_api_token = "<CLOUDFLARE_API_TOKEN>"
