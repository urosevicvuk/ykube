# Copy to shared/secrets.auto.tfvars and fill in your values.
# This file is gitignored. Back it up alongside the tfstate.

# ============================================================
# Proxmox
# ============================================================
# root@pam with a password (not an API token): passing host disks through to
# a VM is root-only in Proxmox.
proxmox_endpoint = "https://<PROXMOX_1_IP>:8006"
proxmox_username = "root@pam"
proxmox_password = "<YOUR_PROXMOX_ROOT_PW>"
proxmox_insecure = true # flip to false once you have valid certs

# Datastore for the VMs' OS + EFI disks (NOT the Ceph disks — those are
# passed through below). Must exist on all three hosts under this name.
# proxmox_disk_datastore = "local-lvm"

# ============================================================
# Talos cluster
# ============================================================
# VIP floats across the controlplanes on the LAN (uplink) NIC. Same subnet as
# the nodes' LAN IPs, outside DHCP scope, not assigned to any machine.
talos_cluster_vip = "<TALOS_API_VIP>" # e.g. 192.168.1.100

# Versions default to the tested combination in shared/variables.tf
# (Talos v1.14.7, Kubernetes 1.36.6). Only override deliberately.
# talos_version      = "v1.14.7"
# kubernetes_version = "1.36.6"

# ============================================================
# Networking
# ============================================================
# Defaults shown — uncomment to override.
# lan_bridge  = "vmbr0"          # 1G uplink to the router
# mesh_bridge = "vmbr1"          # OVS RSTP bridge over the two 25G DAC ports
# mesh_cidr   = "10.10.0.0/24"   # cluster network; static mesh_ip per node below
# mesh_mtu    = 9000             # jumbo frames on the mesh
#
# Mesh IP plan (10.10.0.0/24):
#   .1-.3   Proxmox hosts themselves (on vmbr1; corosync link 0)
#   .11-.13 controlplanes
#   .21-.26 workers

# ============================================================
# Nodes — one entry per Talos VM
# ============================================================
# 3 Proxmox hosts x (1 controlplane + 2 workers). pve_node must be the
# Proxmox node name exactly; it becomes the node's topology.kubernetes.io/zone
# label, which is what keeps Ceph replicas, Vault raft members and CNPG
# instances on different physical machines.
#
# Don't rename keys after first apply (Ceph OSD / CRUSH entries are per
# hostname). Size cpu/memory to your hardware; workers carry the workloads.
#
# LAN MACs: printf "BC:24:11:%02X:%02X:%02X\n" $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256))
# Reserve each MAC as a static DHCP lease on the router so LAN IPs don't drift.
# The mesh NIC gets a static mesh_ip and a Proxmox-generated MAC.
#
# ceph_disks: whole physical disks of that worker's Proxmox host, passed
# through. List candidates on each host with
#   ls -l /dev/disk/by-id/ | grep -v -e part -e wwn-
#   lsblk -d -o NAME,SIZE,ROTA,MODEL,SERIAL      (ROTA 0 = SSD/NVMe -> ssd = true)
# Rules:
#   - never the host's boot disk or the disk backing proxmox_disk_datastore
#   - each disk goes to exactly ONE VM; split a host's disks between its two
#     workers so both carry OSDs
#   - disks must be empty: Rook skips anything with partitions or a
#     filesystem. Wipe old disks first: `wipefs -a /dev/disk/by-id/<id>` and
#     `sgdisk --zap-all /dev/disk/by-id/<id>` on the host.
#   - keep the three hosts roughly equal in Ceph capacity: every pool stores
#     one copy per host, so usable space is capped by the smallest host.

nodes = {
  # ---------------- pve-1 ----------------
  "cp-1" = {
    role        = "controlplane"
    vm_id       = 100
    pve_node    = "pve-1"
    proxmox_ip  = "<PROXMOX_1_IP>"
    cpu_cores   = 4
    memory_mb   = 8192
    disk_gb     = 50
    ip_address  = "<CP_1_LAN_IP>"
    mac_address = "<CP_1_MAC>"
    mesh_ip     = "10.10.0.11"
  }
  "wk-1a" = {
    role        = "worker"
    vm_id       = 110
    pve_node    = "pve-1"
    proxmox_ip  = "<PROXMOX_1_IP>"
    cpu_cores   = 8
    memory_mb   = 32768
    disk_gb     = 100
    ip_address  = "<WK_1A_LAN_IP>"
    mac_address = "<WK_1A_MAC>"
    mesh_ip     = "10.10.0.21"
    ceph_disks = [
      { path = "/dev/disk/by-id/<PVE_1_DISK_A>", ssd = true },
    ]
  }
  "wk-1b" = {
    role        = "worker"
    vm_id       = 111
    pve_node    = "pve-1"
    proxmox_ip  = "<PROXMOX_1_IP>"
    cpu_cores   = 8
    memory_mb   = 32768
    disk_gb     = 100
    ip_address  = "<WK_1B_LAN_IP>"
    mac_address = "<WK_1B_MAC>"
    mesh_ip     = "10.10.0.22"
    ceph_disks = [
      { path = "/dev/disk/by-id/<PVE_1_DISK_B>", ssd = true },
    ]
  }

  # ---------------- pve-2 ----------------
  "cp-2" = {
    role        = "controlplane"
    vm_id       = 200
    pve_node    = "pve-2"
    proxmox_ip  = "<PROXMOX_2_IP>"
    cpu_cores   = 4
    memory_mb   = 8192
    disk_gb     = 50
    ip_address  = "<CP_2_LAN_IP>"
    mac_address = "<CP_2_MAC>"
    mesh_ip     = "10.10.0.12"
  }
  "wk-2a" = {
    role        = "worker"
    vm_id       = 210
    pve_node    = "pve-2"
    proxmox_ip  = "<PROXMOX_2_IP>"
    cpu_cores   = 8
    memory_mb   = 32768
    disk_gb     = 100
    ip_address  = "<WK_2A_LAN_IP>"
    mac_address = "<WK_2A_MAC>"
    mesh_ip     = "10.10.0.23"
    ceph_disks = [
      { path = "/dev/disk/by-id/<PVE_2_DISK_A>", ssd = true },
    ]
  }
  "wk-2b" = {
    role        = "worker"
    vm_id       = 211
    pve_node    = "pve-2"
    proxmox_ip  = "<PROXMOX_2_IP>"
    cpu_cores   = 8
    memory_mb   = 32768
    disk_gb     = 100
    ip_address  = "<WK_2B_LAN_IP>"
    mac_address = "<WK_2B_MAC>"
    mesh_ip     = "10.10.0.24"
    ceph_disks = [
      { path = "/dev/disk/by-id/<PVE_2_DISK_B>", ssd = true },
    ]
  }

  # ---------------- pve-3 ----------------
  "cp-3" = {
    role        = "controlplane"
    vm_id       = 300
    pve_node    = "pve-3"
    proxmox_ip  = "<PROXMOX_3_IP>"
    cpu_cores   = 4
    memory_mb   = 8192
    disk_gb     = 50
    ip_address  = "<CP_3_LAN_IP>"
    mac_address = "<CP_3_MAC>"
    mesh_ip     = "10.10.0.13"
  }
  "wk-3a" = {
    role        = "worker"
    vm_id       = 310
    pve_node    = "pve-3"
    proxmox_ip  = "<PROXMOX_3_IP>"
    cpu_cores   = 8
    memory_mb   = 32768
    disk_gb     = 100
    ip_address  = "<WK_3A_LAN_IP>"
    mac_address = "<WK_3A_MAC>"
    mesh_ip     = "10.10.0.25"
    ceph_disks = [
      { path = "/dev/disk/by-id/<PVE_3_DISK_A>", ssd = true },
    ]
  }
  "wk-3b" = {
    role        = "worker"
    vm_id       = 311
    pve_node    = "pve-3"
    proxmox_ip  = "<PROXMOX_3_IP>"
    cpu_cores   = 8
    memory_mb   = 32768
    disk_gb     = 100
    ip_address  = "<WK_3B_LAN_IP>"
    mac_address = "<WK_3B_MAC>"
    mesh_ip     = "10.10.0.26"
    ceph_disks = [
      { path = "/dev/disk/by-id/<PVE_3_DISK_B>", ssd = true },
    ]
  }
}

# ============================================================
# Bootstrap-time secrets
# ============================================================
# These can also be set via TF_VAR_<name> env vars (preferred — keeps them out
# of the tfvars file). Generate the Cloudflare API token in the dashboard with
# Zone:DNS:Edit + Zone:Zone:Read scoped to your cert-manager-managed zones.
cloudflare_api_token = "<CLOUDFLARE_API_TOKEN>"
